{
  "app": "npx ts-node -P tsconfig.json --prefer-ts-exts src/main.ts",
  "output": "cdk.out",
  "watch": {
    "include": [
      "src/**/*.ts",
      "test/**/*.ts"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "yarn.lock",
      "node_modules"
    ]
  },
  "context": {
    "custom:companyName": "Acme Corp.",
    "custom:agentName": "Galileo",
    "deploy:case": "chatbot",
    "deploy:knowledgebase": true,
    "parser:strategy": "FOUNDATION_MODEL",
    "parser:foundationModelId": "global.anthropic.claude-sonnet-4-6",
    "chunking:strategy": "hierarchical",
    "chat:defaultModelId": "global.anthropic.claude-sonnet-4-6",
    "metadata:modelId": "global.anthropic.claude-sonnet-4-6"
  }
}
